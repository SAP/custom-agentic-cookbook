# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

ARG BASE_IMAGE=python:3.12.16-alpine3.24@sha256:5789aa194f757888f41fa3d48e14b6feaa1b57c0af0b56fcb1372d6474d3bff0
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff
FROM ${UV_IMAGE} AS uv
FROM ${BASE_IMAGE} AS builder

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-install-project --no-build \
        --python /usr/local/bin/python --no-managed-python

FROM ${BASE_IMAGE} AS runtime

RUN /usr/local/bin/python -m pip uninstall --yes pip \
    && /usr/local/bin/python -c 'import ensurepip, pathlib, shutil; shutil.rmtree(pathlib.Path(ensurepip.__file__).parent)' \
    && addgroup -S -g 10001 appgroup \
    && adduser -S -D -H -u 10001 -G appgroup -s /sbin/nologin appuser

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/src" \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY --from=builder --chown=10001:10001 /app/.venv ./.venv

COPY --chown=10001:10001 src ./src

ENV HOST="0.0.0.0" \
    PORT="8000" \
    URL="http://localhost:8000" \
    MCP_HOST="127.0.0.1" \
    MCP_PORT="8090" \
    MCP_SERVER_URL="http://localhost:8090/sse" \
    DATA_MODE="mock" \
    LLM_PROVIDER="mock"

EXPOSE 8000

USER 10001:10001

CMD ["python", "-m", "production_order_agent.cf_launcher"]
