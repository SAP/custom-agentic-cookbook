{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "imagePullSecrets",
    "replicaCount",
    "apirule",
    "resources"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[0-9]+)?/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*$",
          "maxLength": 255
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$",
          "not": {
            "enum": [
              "latest"
            ]
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
      }
    },
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "apirule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "host",
        "gateway",
        "noAuth"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "gateway": {
          "type": "string",
          "minLength": 1
        },
        "noAuth": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "mcp"
      ],
      "properties": {
        "agent": {
          "$ref": "#/definitions/resources"
        },
        "mcp": {
          "$ref": "#/definitions/resources"
        }
      }
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
